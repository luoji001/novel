+def copied_units(text: str, prior: list[str], min_len: int) -> int:
+    """剥完 echo 之后，候选里还有几句（句子或台词）在本章前几场里逐字出现过。
+
+    **只计数、不剥。** 两个 strip 都按整段比对，模型把衔接窗口里的句子换个
+    归属词、拆段或并段再写一遍就漏过去了（`shipin-20261027-07` 第 4 章：
+    「“你爸当年寄存的时候……”老周叹气」→「……”他叹气」）。句级剥会把
+    「他说」这类归属留成断句，所以这一层交给 `pick_best_scene` 去**选**。
+
+    口径与章级硬闸门 `sentence_duplicate_reasons` 一致（同一个 `_dup_units`、
+    同一个 `min_len`）：这里数到的每一句，拼章之后都会变成一条「章内自我复读」。
+    """
+    if not prior:
+        return 0
+    # 句子、台词两个列表分开比 —— 闸门就是分开数的，同一句台词会在两边各记一次
+    seen_s: set[str] = set()
+    seen_d: set[str] = set()
+    for t in prior:
+        s, d = _dup_units(t, min_len)
+        seen_s.update(s)
+        seen_d.update(d)
+    s, d = _dup_units(text, min_len)
+    return len(set(s) & seen_s) + len(set(d) & seen_d)
+
